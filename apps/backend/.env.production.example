# Production (hosted Turso) database credentials - used ONLY by
# `pnpm --filter @cafe-system/backend db:migrate:prod`.
# Copy to apps/backend/.env.production (git-ignored) and fill in.
# Keep these out of .env: that file is for local development, and dev
# commands refuse to run against a remote database.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=
