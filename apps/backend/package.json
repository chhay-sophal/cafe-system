{
	"name": "@cafe-system/backend",
	"version": "1.0.0",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"start": "node dist/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/db/seed.ts",
		"db:create-admin": "tsx src/db/create-admin.ts",
		"db:backup": "tsx src/db/run-backup-cli.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.700.0",
		"@libsql/client": "^0.14.0",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"node-cron": "^4.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bcryptjs": "^3.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.1.2",
		"@types/node-cron": "^3.0.11",
		"@types/supertest": "^7.2.1",
		"drizzle-kit": "^0.31.10",
		"supertest": "^7.2.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.10",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
