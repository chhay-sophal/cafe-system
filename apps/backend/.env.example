PORT=3000
JWT_SECRET=change-this-in-production

# --- Database ---
# Leave TURSO_DATABASE_URL unset here: dev and on-prem use the local SQLite
# file at apps/backend/data/store_data.db, and outside production the backend
# and db:* commands refuse a remote database. The hosted (Render + Turso)
# database gets its URL from Render's environment at runtime, and is migrated
# from a dev machine with `db:migrate:prod`, which reads .env.production
# (see .env.production.example).

# --- Optional: only needed to upload product images to Cloudflare R2 ---
# Leave all unset for on-prem/dev to keep saving images to local disk.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://images.yourdomain.com
