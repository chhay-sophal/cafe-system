PORT=3000
JWT_SECRET=change-this-in-production

# --- Optional: only needed for the hosted Render + Turso deploy target ---
# Leave unset for on-prem/dev - defaults to the local SQLite file at
# apps/backend/data/store_data.db.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# --- Optional: only needed to upload product images to Cloudflare R2 ---
# Leave all unset for on-prem/dev to keep saving images to local disk.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://images.yourdomain.com
