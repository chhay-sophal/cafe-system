node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.pnpm-debug.log*

npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

####################################
# Build Outputs (general)
####################################
dist/
build/
coverage/
**/dist/
**/build/
**/coverage/
*.tsbuildinfo

####################################
# Turborepo
####################################
.turbo/
**/.turbo/

####################################
# Environment & Secrets
####################################
.env
.env.local
.env.*.local
.env.*
!.env.example

####################################
# Backend (Express + Drizzle + SQLite)
####################################
apps/backend/.drizzle/
apps/backend/.cache/

# Local SQLite database files
*.db
*.db-journal
*.db-shm
*.db-wal
apps/backend/data/store_data.db
apps/backend/data/store_data.db-journal
apps/backend/data/store_data.db-shm
apps/backend/data/store_data.db-wal

# Automated database backups
backups/
apps/backend/backups/

# Uploaded media — keep the directory structure, ignore its contents
apps/backend/uploads/*
!apps/backend/uploads/.gitkeep
!apps/backend/uploads/**/.gitkeep

####################################
# Nuxt 3 / Vue (apps/ims)
####################################
apps/ims/.nuxt/
apps/ims/.output/
apps/ims/.nitro/
apps/ims/.cache/
apps/ims/.data/
**/.nuxt/
**/.output/

####################################
# Tauri v2 & Rust (apps/pos)
####################################
apps/pos/src-tauri/target/
apps/pos/src-tauri/gen/
apps/pos/src-tauri/wix/
apps/pos/src-tauri/Cargo.lock

# Native installers / bundle outputs
*.exe
*.msi
*.app
*.dmg
*.deb
*.AppImage

####################################
# OS Files
####################################
.DS_Store
Thumbs.db

####################################
# Editor Files
####################################
.vscode/*
!.vscode/settings.json
.idea/

####################################
